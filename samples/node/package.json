{
  "name": "darudb-sample-node",
  "private": true,
  "version": "0.0.0",
  "description": "A sample app of DaruDB for Node.js: the same screens as an Electron app and as a web page served by a local server, with end-to-end tests of both.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.ts",
  "scripts": {
    "start": "vite build --configLoader native && electron .",
    "web": "vite build --configLoader native && node server/main.ts",
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "typecheck": "tsc",
    "test": "npm run build && playwright test",
    "test:web": "npm run build && playwright test --project web",
    "test:electron": "npm run build && playwright test --project electron",
    "format": "prettier . --check",
    "format:fix": "prettier . --write"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "darudb": "file:../../packages/node",
    "plass-ui": "^1.8.1",
    "randino": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.6.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  }
}
