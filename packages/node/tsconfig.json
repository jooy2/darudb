{
  // The package's JavaScript, compiled from `lib` into `dist`, which is what
  // ships. `dist` sits at the same depth as `lib`, so a path to `native.js`
  // at the package's root is the same from either.
  "compilerOptions": {
    "rootDir": "lib",
    "outDir": "dist",
    "target": "es2022",
    // `String.prototype.isWellFormed` is ES2024, and Node.js 20, the oldest
    // the package supports, has it.
    "lib": ["es2022", "es2024.string"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "declaration": false,
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": false
  },
  "include": ["lib"]
}
