# Node artifact files
node_modules/

# Log files
*.log

# dotenv environment variables file
.env

# JetBrains IDEs
.idea/
*.iml

# Visual Studio Code IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Generated by MacOS
.DS_Store
.AppleDouble
.LSOverride

# Generated by Windows
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Rust. One `target/` for the whole Cargo workspace, at the repository root.
target/

# Project files
dist/
docs-dist/
coverage/

# The Node.js binding. `npm run build` in `packages/node` writes the native
# addon and the two files that load it and describe it, all from `src/lib.rs`.
# `index.js` and `index.d.ts` beside them are written by hand.
packages/node/*.node
packages/node/native.js
packages/node/native.d.ts
# Per-platform packages, created by the napi CLI at release time.
packages/node/npm/

# The Dart packages. `.dart_tool/` holds what pub and the build hooks make,
# the native library among it, and `build_runner` writes the `.g.dart` parts
# of the tests' models. A library package keeps no `pubspec.lock`: its users
# resolve its dependencies their own way, and CI checks both ends of the
# generator's constraints.
packages/dart/*/.dart_tool/
packages/dart/*/pubspec.lock
packages/dart/*/test/**/*.g.dart
packages/dart/*/build/

# The Python package. `maturin develop` puts the native module beside the
# Python code it belongs to, and a virtual environment for working on the
# package goes in `.venv/`. The tools leave caches of their own.
packages/python/.venv/
packages/python/python/darudb/*.so
packages/python/python/darudb/*.pyd
# Written by `tool/notices.py` before the release workflow builds a wheel.
packages/python/python/darudb/THIRD_PARTY_NOTICES.txt
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# VitePress files
docs/.vitepress/.temp
docs/.vitepress/.temp/*
docs/.vitepress/cache
docs/.vitepress/cache/*

# Generated by `docs/scripts/copy-changelog.mjs` from each package's CHANGELOG.md
docs/*/changelog.md

# Claude Code. `CLAUDE.md` is committed; what is under `.claude/` is per machine.
.claude/
