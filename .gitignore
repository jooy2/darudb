# Node artifact files
node_modules/

# Log files
*.log

# dotenv environment variables file
.env

# JetBrains IDEs
.idea/
*.iml

# Visual Studio Code IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Generated by MacOS
.DS_Store
.AppleDouble
.LSOverride

# Generated by Windows
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Rust. One `target/` for the whole Cargo workspace, at the repository root.
target/

# Project files
dist/
docs-dist/
coverage/

# The Node.js binding. `npm run build` in `packages/node` writes the native
# addon and the two files that load it and describe it, all from `src/lib.rs`.
packages/node/*.node
packages/node/index.js
packages/node/index.d.ts
# Per-platform packages, created by the napi CLI at release time.
packages/node/npm/

# VitePress files
docs/.vitepress/.temp
docs/.vitepress/.temp/*
docs/.vitepress/cache
docs/.vitepress/cache/*

# Generated by `docs/scripts/copy-changelog.mjs` from each package's CHANGELOG.md
docs/*/changelog.md

# Claude Code. `CLAUDE.md` is committed; what is under `.claude/` is per machine.
.claude/
